{
  "name": "bubble-grove",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "An offline, touch-first word association game. No ads. Just connections.",
  "scripts": {
    "start": "vite",
    "preview": "node scripts/server.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test",
    "test:browser": "npm run build && node scripts/browser-check.mjs",
    "test:interactions": "npm run build && node scripts/interaction-check.mjs",
    "test:polish": "npm run build && node scripts/polish-check.mjs",
    "test:arrivals": "npm run build && node scripts/arrival-check.mjs",
    "test:soft-bodies": "npm run build && node scripts/soft-body-check.mjs",
    "test:input-keys": "npm run build && node scripts/input-key-check.mjs",
    "test:screws": "npm run build && node scripts/screw-check.mjs",
    "test:special-rules": "npm run build && node scripts/special-rules-check.mjs",
    "test:specials": "npm run build && node scripts/specials-check.mjs",
    "test:physics-controls": "npm run build && node scripts/physics-controls-check.mjs",
    "check": "node scripts/check.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@dimforge/rapier2d-compat": "^0.21.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "animejs": "^4.5.0",
    "canvas-confetti": "^1.9.4"
  },
  "devDependencies": {
    "sharp": "^0.35.5",
    "vite": "^8.3.4"
  }
}
